# Porta su cui ascolta l'applicazione (pronta per Nginx/Caddy reverse proxy)
PORT=3080

# Indirizzo di bind (0.0.0.0 per Docker / VPS)
HOST=0.0.0.0

# Password per accedere al pannello /admin (CAMBIALA PRIMA DEL DEPLOY!)
ADMIN_PASSWORD=cambia-questa-password-sicura

# Chiave segreta per firmare i cookie di sessione admin (lascia vuota per generarla a runtime, oppure imposta 32+ caratteri casuali)
SESSION_SECRET=

# Imposta a "true" se servi l'app dietro HTTPS (Nginx/Caddy con SSL)
COOKIE_SECURE=false

# Imposta a "true" se l'app è dietro reverse proxy (per loggare il vero IP client)
TRUST_PROXY=true

# Percorso del file database SQLite
DB_PATH=./db/patente.sqlite
